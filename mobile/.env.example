# Values beginning with EXPO_PUBLIC_ are intentionally visible in the app bundle.
# Use only the Supabase publishable key here. Never add service_role, database,
# Cloudflare API, GitHub, or signing secrets to this file.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
EXPO_PUBLIC_TEACHER_API_URL=https://YOUR_WORKER.workers.dev
